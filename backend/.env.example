# Copia este archivo como .env (en esta misma carpeta backend/) y llena tus datos.
# El archivo .env NO se sube a git.

# console = imprime los correos en el log | smtp = los envía de verdad
MAIL_MODE=smtp

# Gmail: usa una "contraseña de aplicación" (16 letras), no tu contraseña normal.
# Se crea en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx

# Opcional: remitente que ve el destinatario (por defecto, MAIL_USERNAME)
# MAIL_FROM=tu-correo@gmail.com
